FROM rust:latest

RUN apt-get update && apt-get install -y \
    fuse3 libfuse-dev pkg-config \
    autoconf automake libtool \
    perl \
    && rm -rf /var/lib/apt/lists/*

# Build pjdfstest
RUN git clone https://github.com/pjd/pjdfstest.git /opt/pjdfstest \
    && cd /opt/pjdfstest \
    && autoreconf -ifs \
    && ./configure \
    && make

WORKDIR /app
COPY Cargo.toml Cargo.lock* ./
COPY crates/ crates/

RUN cargo build --release

RUN mkdir -p /tmp/oxfs-mount /tmp/oxfs-data

COPY scripts/run-pjdfstest.sh /app/run-pjdfstest.sh
RUN chmod +x /app/run-pjdfstest.sh

ENTRYPOINT ["/app/run-pjdfstest.sh"]
